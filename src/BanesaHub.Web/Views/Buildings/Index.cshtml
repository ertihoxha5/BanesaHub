@model BanesaHub.Web.Inventory.BuildingList
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_InventoryLayout";
    ViewData["Title"] = "Ndërtesat";
}

<a asp-controller="Inventory" asp-action="Index" asp-route-organizationId="@Model.OrganizationId">Kthehu te pronat</a>
<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mt-3">
    <h1>Ndërtesat</h1>
    <a class="btn btn-primary" asp-action="Create" asp-route-organizationId="@Model.OrganizationId"
       asp-route-propertyId="@Model.PropertyId">Shto ndërtesë</a>
</div>
<p>@Model.PropertyName</p>

@if (Model.Rows.Length == 0)
{
    <p class="panel empty-state">Nuk u gjet asnjë ndërtesë.</p>
}
else
{
    <div class="panel table-responsive inventory-table">
        <table class="table align-middle mb-0">
            <caption class="visually-hidden">Lista e ndërtesave</caption>
            <thead><tr><th scope="col">Ndërtesa</th><th scope="col">Katet</th><th scope="col">Veprimet</th></tr></thead>
            <tbody>
            @foreach (var item in Model.Rows)
            {
                <tr>
                    <th scope="row">@item.Name</th>
                    <td>@(item.FloorCount?.ToString("N0") ?? "—")</td>
                    <td>
                        <div class="d-flex flex-wrap gap-2">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-buildingId="@item.Id"
                               asp-route-organizationId="@Model.OrganizationId" asp-route-propertyId="@Model.PropertyId"
                               aria-label="Ndrysho @item.Name">Ndrysho</a>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Archive" asp-route-buildingId="@item.Id"
                               asp-route-organizationId="@Model.OrganizationId" asp-route-propertyId="@Model.PropertyId"
                               aria-label="Arkivo @item.Name">Arkivo</a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@if (Model.Page > 1 || Model.HasNext)
{
    <nav class="inventory-pagination" aria-label="Faqet e ndërtesave">
        @if (Model.Page > 1)
        {
            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-organizationId="@Model.OrganizationId"
               asp-route-propertyId="@Model.PropertyId" asp-route-page="@(Model.Page - 1)">Para</a>
        }
        <span>Faqja @Model.Page</span>
        @if (Model.HasNext)
        {
            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-organizationId="@Model.OrganizationId"
               asp-route-propertyId="@Model.PropertyId" asp-route-page="@(Model.Page + 1)">Tjetra</a>
        }
    </nav>
}
