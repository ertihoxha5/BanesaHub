@model BanesaHub.Web.Inventory.TenantProfile
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_InventoryLayout";
    ViewData["Title"] = "Profili i qiramarrësit";
}
<a asp-action="Index" asp-route-organizationId="@Model.OrganizationId">Kthehu te qiramarrësit</a>
<h1 class="mt-3">@Model.Contact.FullName</h1>
<div class="panel entry">
    <dl>
        <dt>Emaili</dt><dd>@(Model.Contact.Email ?? "—")</dd>
        <dt>Telefoni</dt><dd>@(Model.Contact.Phone ?? "—")</dd>
    </dl>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-primary" asp-action="Edit" asp-route-organizationId="@Model.OrganizationId"
           asp-route-tenantId="@Model.Contact.Id">Ndrysho</a>
        <a class="btn btn-outline-secondary" asp-action="Archive" asp-route-organizationId="@Model.OrganizationId"
           asp-route-tenantId="@Model.Contact.Id">Arkivo</a>
    </div>
</div>
