@model BanesaHub.Web.Inventory.TenantList
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_InventoryLayout";
    ViewData["Title"] = "Qiramarrësit";
}
<a asp-controller="Inventory" asp-action="Index" asp-route-organizationId="@Model.OrganizationId">Kthehu te pronat</a>
<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mt-3">
    <h1>Qiramarrësit</h1>
    <a class="btn btn-primary" asp-action="Create" asp-route-organizationId="@Model.OrganizationId">Shto qiramarrës</a>
</div>
<form method="get" asp-action="Index" asp-route-organizationId="@Model.OrganizationId" class="panel entry mb-3">
    <label class="form-label" for="search">Kërko sipas emrit</label>
    <input class="form-control" type="search" id="search" name="search" value="@Model.Search" maxlength="200">
    <button class="btn btn-primary mt-3" type="submit">Kërko</button>
</form>
@if (Model.Rows.Length == 0)
{
    <p class="panel empty-state">Nuk u gjet asnjë qiramarrës.</p>
}
else
{
    <div class="panel table-responsive inventory-table">
        <table class="table align-middle mb-0">
            <caption class="visually-hidden">Lista e qiramarrësve</caption>
            <thead><tr><th scope="col">Emri dhe mbiemri</th><th scope="col">Emaili</th><th scope="col">Telefoni</th></tr></thead>
            <tbody>
            @foreach (var contact in Model.Rows)
            {
                <tr>
                    <th scope="row">
                        <a asp-action="Profile" asp-route-organizationId="@Model.OrganizationId"
                           asp-route-tenantId="@contact.Id">@contact.FullName</a>
                    </th>
                    <td>@(contact.Email ?? "—")</td>
                    <td>@(contact.Phone ?? "—")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
@if (Model.Page > 1 || Model.HasNext)
{
    <nav class="inventory-pagination" aria-label="Faqet e qiramarrësve">
        @if (Model.Page > 1)
        {
            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-organizationId="@Model.OrganizationId"
               asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search">Para</a>
        }
        <span>Faqja @Model.Page</span>
        @if (Model.HasNext)
        {
            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-organizationId="@Model.OrganizationId"
               asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search">Tjetra</a>
        }
    </nav>
}
