@model BanesaHub.Web.Inventory.PropertyList
@using BanesaHub.Web.Inventory
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_InventoryLayout";
    ViewData["Title"] = "Pronat";
}
<div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
    <h1>Pronat</h1>
    @if (Model.Rows is not null)
    {
        <a class="btn btn-primary" asp-controller="PropertyForms" asp-action="Create"
           asp-route-organizationId="@Model.OrganizationId">Shto pronë</a>
    }
</div>

@if (Model.Message is not null)
{
    <p class="alert alert-warning" role="alert">@Model.Message</p>
}

@if (Model.OrganizationId == Guid.Empty)
{
    <form method="get" asp-controller="Inventory" asp-action="Home" class="panel entry">
        <label class="form-label" for="organizationId">Identifikuesi i organizatës</label>
        <input class="form-control" id="organizationId" name="organizationId" required maxlength="36">
        <button class="btn btn-primary mt-3" type="submit">Hapni pronat</button>
    </form>
}
else if (Model.SignInRequired)
{
    <form method="post" asp-controller="Inventory" asp-action="SignIn" asp-route-organizationId="@Model.OrganizationId" class="panel entry">
        <h2 class="h5 mb-3">Hyni për të parë pronat</h2>
        <label class="form-label" for="email">Emaili</label>
        <input class="form-control mb-3" type="email" id="email" name="email" autocomplete="username" required maxlength="256">
        <label class="form-label" for="password">Fjalëkalimi</label>
        <input class="form-control" type="password" id="password" name="password" autocomplete="current-password" required maxlength="128">
        <button class="btn btn-primary mt-3" type="submit">Hyni</button>
    </form>
}
else
{
    <form method="get" asp-controller="Inventory" asp-action="Index" asp-route-organizationId="@Model.OrganizationId" class="panel filter-form">
        <div>
            <label class="form-label" for="search">Emri ose adresa</label>
            <input class="form-control" type="search" id="search" name="search" value="@Model.Search" maxlength="200">
        </div>
        <div>
            <label class="form-label" for="status">Gjendja</label>
            <select class="form-select" id="status" name="status">
                <option value="">Të gjitha</option>
                <option value="Draft" selected="@(Model.Status == PropertyFilter.Draft)">Draft</option>
                <option value="Active" selected="@(Model.Status == PropertyFilter.Active)">Aktive</option>
            </select>
        </div>
        <button class="btn btn-primary" type="submit">Filtro</button>
    </form>

    @if (Model.Rows is { Count: > 0 } rows)
    {
        <div class="panel table-responsive inventory-table">
            <table class="table align-middle mb-0">
                <caption class="visually-hidden">Lista e pronave</caption>
                <thead>
                    <tr><th scope="col">Prona</th><th scope="col">Adresa</th><th scope="col">Kategoria</th><th scope="col">Gjendja</th><th scope="col">Veprimet</th></tr>
                </thead>
                <tbody>
                @foreach (var property in rows)
                {
                    <tr>
                        <th scope="row">@property.Name</th>
                        <td>@(property.Address ?? "—")</td>
                        <td>@(property.Category ?? "—")</td>
                        <td><span class="property-status @(property.Status == PropertyFilter.Active ? "active-status" : "")">@(property.Status == PropertyFilter.Active ? "Aktive" : "Draft")</span></td>
                        <td>
                            <div class="d-flex flex-wrap gap-2">
                                <a class="btn btn-sm btn-outline-primary" asp-controller="Buildings" asp-action="Index"
                                   asp-route-organizationId="@Model.OrganizationId" asp-route-propertyId="@property.Id"
                                   aria-label="Ndërtesat e pronës @property.Name">Ndërtesat</a>
                                <a class="btn btn-sm btn-outline-primary" asp-controller="PropertyForms" asp-action="Edit"
                                   asp-route-organizationId="@Model.OrganizationId" asp-route-propertyId="@property.Id"
                                   aria-label="Ndrysho @property.Name">Ndrysho</a>
                                <a class="btn btn-sm btn-outline-secondary" asp-controller="PropertyForms" asp-action="Archive"
                                   asp-route-organizationId="@Model.OrganizationId" asp-route-propertyId="@property.Id"
                                   aria-label="Arkivo @property.Name">Arkivo</a>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else if (Model.Rows is not null)
    {
        <p class="panel empty-state">Nuk u gjet asnjë pronë.</p>
    }

    @if (Model.Rows is not null && (Model.Page > 1 || Model.HasNext))
    {
        <nav class="inventory-pagination" aria-label="Faqet e pronave">
            @if (Model.Page > 1)
            {
                <a class="btn btn-outline-secondary" asp-controller="Inventory" asp-action="Index" asp-route-organizationId="@Model.OrganizationId"
                   asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status">Para</a>
            }
            <span>Faqja @Model.Page</span>
            @if (Model.HasNext)
            {
                <a class="btn btn-outline-secondary" asp-controller="Inventory" asp-action="Index" asp-route-organizationId="@Model.OrganizationId"
                   asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status">Tjetra</a>
            }
        </nav>
    }
}
